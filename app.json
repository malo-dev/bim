{
  "expo": {
    "name": "BimNext",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bimnext",
    "userInterfaceStyle": "automatic",
    // "newArchEnabled": true,
    "extra": {
      "API_URL": "https://serverbimnext.masmara-dimajelo.org/api/v1",
      // "API_URL": "http://10.0.10.81:5000/api/v1",
      "eas": {
        "projectId": "68b578a1-d490-4427-848d-a5e0d8ba1280"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bimnext.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Autoriser l'accès à la caméra pour scanner les QR codes",
        "NSLocationWhenInUseUsageDescription": "Autoriser l'accès à la localisation",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      // "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.bimnext.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser l'accès à la caméra pour scanner les QR codes"
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser l'accès à votre localisation"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0353CC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
